# ============================================================
# RemoteDesk API — variables de entorno
# Copiar como .env y completar con valores reales.
# NUNCA subir .env al repositorio.
# ============================================================

# Base de datos PostgreSQL
DATABASE_URL=postgres://remotedesk:changeme@db:5432/remotedesk

# JWT
JWT_SECRET=cambia-este-secreto-jwt-muy-largo-y-aleatorio
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

# Servidor
PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:4000

# TURN (coturn) -- opcional, solo necesario si WebRTC P2P falla
# TURN_HOST=turn.mi-dominio.com
# TURN_SECRET=cambia-este-secreto-coturn
